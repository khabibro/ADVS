APP_ENV=development
APP_NAME=ADVS
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Admin console: link to the applicant web app, and the API address its server-side proxy uses.
NEXT_PUBLIC_WEB_URL=http://localhost:3000
ADVS_API_URL=http://localhost:8000/api/v1
# When set, /api/v1/admin/* requires this token (X-ADVS-Admin-Token). Set the same value for the
# API and the admin console; the console adds it on its server, never in the browser.
# ADMIN_API_TOKEN=change-me
DATABASE_URL=postgresql+psycopg://advs:advs@db:5432/advs
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=20
OCR_PROVIDER=paddle
PADDLE_OCR_DEVICE=cpu
PADDLE_OCR_LANG=korean
PADDLE_OCR_REC_MODEL_NAME=korean_PP-OCRv5_mobile_rec
PADDLE_OCR_DET_MODEL_NAME=PP-OCRv5_mobile_det
PADDLE_OCR_CACHE_DIR=./storage/paddleocr-cache
LOG_LEVEL=INFO
